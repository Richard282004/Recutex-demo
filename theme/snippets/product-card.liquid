{%- comment -%}
  Product card. All data comes from Shopify (title, images, price, availability, variants).
  Accepts:
  - product: {Object} (required)
  - lazy: {Boolean} lazy-load images (default true; pass false for above-the-fold cards)
  - sizes: {String} sizes attribute for the image
  - quick_add: {Boolean} show quick add (default true)
{%- endcomment -%}
{%- liquid
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign img_sizes = sizes | default: '(min-width: 1200px) 22vw, (min-width: 750px) 30vw, 48vw'
  assign secondary = product.media[1]
  assign first_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<article
  class="product-card{% if secondary and secondary.media_type == 'image' %} product-card--has-hover{% endif %}"
  data-reveal
>
  <div class="product-card__media-wrap">
    <div class="product-card__media">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 1000
          | image_tag:
            loading: loading,
            widths: '240, 360, 480, 640, 800, 1000',
            sizes: img_sizes,
            alt: product.featured_media.alt
          | default: product.title, class: 'product-card__image product-card__image--primary'
        }}
        {%- if secondary and secondary.media_type == 'image' -%}
          {{
            secondary
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '240, 360, 480, 640, 800, 1000',
              sizes: img_sizes,
              alt: '',
              class: 'product-card__image product-card__image--secondary'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}

      <div class="product-card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--muted">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif on_sale -%}
          <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
        {%- endif -%}
      </div>
    </div>

    {%- if quick_add != false and product.available -%}
      <div class="product-card__quick-add">
        {%- if product.has_only_default_variant -%}
          {%- form 'product', product, class: 'product-card__form', data-product-form: '' -%}
            <input type="hidden" name="id" value="{{ first_variant.id }}">
            <button
              class="button button--light button--small"
              type="submit"
              name="add"
              aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}"
            >
              <span class="button__label">
                <span class="button__plus">{% render 'icon', name: 'plus' %}</span>
                <span class="button__text">{{ 'products.product.add_to_cart' | t }}</span>
              </span>
              <span class="button__state button__state--loading"><span class="spinner"></span></span>
              <span class="button__state button__state--success">{% render 'icon', name: 'check' %}</span>
            </button>
          {%- endform -%}
        {%- else -%}
          <a
            class="button button--light button--small"
            href="{{ product.url }}"
            aria-label="{{ 'products.product.choose_options' | t }}: {{ product.title | escape }}"
            tabindex="-1"
          >
            <span class="button__label">
              <span class="button__plus">{% render 'icon', name: 'plus' %}</span>
              <span class="button__text">{{ 'products.product.choose_options' | t }}</span>
            </span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
    {%- unless product.has_only_default_variant -%}
      {%- assign first_option = product.options_with_values.first -%}
      <p class="product-card__options">
        {{ 'products.product.options_count' | t: count: first_option.values.size, option: first_option.name }}
      </p>
    {%- endunless -%}
    {%- render 'price', product: product -%}
  </div>
</article>
