{%- comment -%}
  Design tokens driven by Theme Editor settings. Static tokens live in base.css.
{%- endcomment -%}
{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_body_font
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
-%}

{{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- if settings.type_heading_brand -%}
  {{ 'bricolage-grotesque-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- endif -%}

{% style %}
  {%- if settings.type_heading_brand -%}
    @font-face {
      font-family: 'Bricolage Grotesque';
      src: url('{{ 'bricolage-grotesque-latin.woff2' | asset_url }}') format('woff2');
      font-weight: 400 800;
      font-style: normal;
      font-display: swap;
    }
  {%- else -%}
    {{ heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}

  :root {
    --color-primary: {{ settings.color_primary }};
    --color-secondary: {{ settings.color_secondary }};
    --color-background: {{ settings.color_background }};
    --color-surface: {{ settings.color_surface }};
    --color-text: {{ settings.color_text }};
    --color-muted: {{ settings.color_muted }};
    --color-sale: {{ settings.color_sale }};
    --color-primary-rgb: {{ settings.color_primary.red }} {{ settings.color_primary.green }} {{ settings.color_primary.blue }};
    --color-text-rgb: {{ settings.color_text.red }} {{ settings.color_text.green }} {{ settings.color_text.blue }};

    {%- if settings.type_heading_brand %}
      --font-heading: 'Bricolage Grotesque', {{ body_font.family }}, {{ body_font.fallback_families }};
      --font-heading-weight: 650;
    {%- else %}
      --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --font-heading-weight: {{ heading_font.weight }};
    {%- endif %}
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-bold: {{ body_font_bold.weight | default: 700 }};

    --logo-width: {{ settings.logo_width }}px;
  }
{% endstyle %}
