{%- comment -%}
  Renders a product price. Discount shown ONLY when Shopify has a real compare_at_price.
  Accepts:
  - product: {Object} product (required)
  - use_variant: {Boolean} use selected_or_first_available_variant instead of the price range
{%- endcomment -%}
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
    assign price = target.price
    assign compare_at_price = target.compare_at_price
    assign available = target.available
  else
    assign target = product
    assign price = product.price
    assign compare_at_price = product.compare_at_price
    assign available = product.available
  endif

  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif
-%}

{%- liquid
  assign price_formatted = price | money
  assign show_from = false
  if use_variant != true and product.price_varies
    assign show_from = true
  endif
-%}

<div class="price{% if on_sale %} price--on-sale{% endif %}{% unless available %} price--sold-out{% endunless %}">
  {%- if on_sale -%}
    {%- assign discount_percent = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price -%}
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
    <span class="price__current">
      {%- if show_from -%}
        {{- 'products.product.from_price' | t: price: price_formatted -}}
      {%- else -%}
        {{- price_formatted -}}
      {%- endif -%}
    </span>
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price__compare">{{ compare_at_price | money }}</s>
    <span class="price__badge">-{{ discount_percent }}%</span>
  {%- elsif show_from -%}
    <span class="price__current">{{ 'products.product.from_price' | t: price: price_formatted }}</span>
  {%- else -%}
    <span class="price__current">{{ price_formatted }}</span>
  {%- endif -%}
</div>
