<!doctype html>
<html class="no-js{% if settings.animations_reveal %} js-reveal{% endif %}" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'css-variables' -%}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'component-overlays.css' | asset_url | stylesheet_tag }}

    <script>
      {%- comment -%} Remove the reveal class early if JS modules are unsupported, so content never stays hidden. {%- endcomment -%}
      if (!('IntersectionObserver' in window) || !('customElements' in window)) {
        document.documentElement.classList.remove('js-reveal');
      }
      // Safety net: if theme.js never runs (network error), never leave content hidden.
      window.addEventListener('load', function () {
        setTimeout(function () {
          if (!document.documentElement.hasAttribute('data-theme-ready')) {
            document.documentElement.classList.remove('js-reveal');
          }
        }, 1500);
      });
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and request.page_type != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if settings.whatsapp_number != blank -%}
      {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' -%}
      <a
        class="whatsapp-button"
        href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}"
        target="_blank"
        rel="noopener"
      >
        <svg aria-hidden="true" focusable="false" viewBox="0 0 32 32" fill="currentColor">
          <path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7a10.7 10.7 0 0 1-5.5-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.2c-.2.2-.4.3-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4a3.7 3.7 0 0 0-1.1 2.7c0 1.6 1.2 3.2 1.3 3.4.2.2 2.3 3.5 5.6 4.9 2.1.9 2.9 1 4 .8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.8-.6Z"/>
        </svg>
        <span class="visually-hidden">{{ 'general.contact.whatsapp' | t }}</span>
      </a>
    {%- endif -%}
  </body>
</html>
