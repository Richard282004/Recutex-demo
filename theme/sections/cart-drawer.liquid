{%- comment -%}
  Cart drawer. Rendered in layout/theme.liquid and re-rendered through the Section Rendering API
  after /cart/add.js and /cart/change.js calls (see <cart-drawer> in theme.js).
  Checkout always goes through Shopify Checkout.
{%- endcomment -%}
<cart-drawer class="drawer drawer--right" id="CartDrawer" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div
    class="drawer__panel cart-drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
    tabindex="-1"
  >
    <div class="drawer__header">
      <h2 class="drawer__title" id="CartDrawerTitle">
        {{ 'cart.general.title' | t }}
        {%- if cart.item_count > 0 %}
          <span class="cart-drawer__count">({{ cart.item_count }})</span>
        {%- endif -%}
      </h2>
      <button class="icon-button" type="button" data-drawer-close>
        {% render 'icon', name: 'close' %}
        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
      </button>
    </div>

    <div class="drawer__body" data-cart-drawer-body>
      {%- if cart.item_count > 0 -%}
        <ul class="cart-drawer__items" role="list">
          {%- for item in cart.items -%}
            <li class="cart-line" data-line="{{ forloop.index }}">
              <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{
                    item.image
                    | image_url: width: 200
                    | image_tag: loading: 'lazy', widths: '100, 200', sizes: '88px', alt: ''
                  }}
                {%- endif -%}
              </a>
              <div class="cart-line__details">
                <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__meta">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- assign property_first_char = property.first | slice: 0 -%}
                  {%- unless property.last == blank or property_first_char == '_' -%}
                    <p class="cart-line__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                  {%- endunless -%}
                {%- endfor -%}
                <div class="cart-line__bottom">
                  <quantity-input class="quantity quantity--small">
                    <button
                      class="quantity__button"
                      type="button"
                      name="minus"
                      aria-label="{{ 'cart.general.decrease' | t: title: item.product.title }}"
                    >
                      −
                    </button>
                    <input
                      class="quantity__input"
                      type="number"
                      value="{{ item.quantity }}"
                      min="0"
                      inputmode="numeric"
                      aria-label="{{ 'products.product.quantity' | t }}: {{ item.product.title | escape }}"
                      data-line-quantity="{{ forloop.index }}"
                    >
                    <button
                      class="quantity__button"
                      type="button"
                      name="plus"
                      aria-label="{{ 'cart.general.increase' | t: title: item.product.title }}"
                    >
                      +
                    </button>
                  </quantity-input>
                  <div class="cart-line__price">
                    {%- if item.original_line_price > item.final_line_price -%}
                      <s class="price__compare">{{ item.original_line_price | money }}</s>
                    {%- endif -%}
                    <span class="price__current">{{ item.final_line_price | money }}</span>
                  </div>
                </div>
                <button class="cart-line__remove" type="button" data-line-remove="{{ forloop.index }}">
                  {{- 'cart.general.remove_short' | t -}}
                  <span class="visually-hidden">{{ item.product.title | escape }}</span>
                </button>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.recommendations -%}
          <cart-recommendations
            class="cart-drawer__recommendations"
            data-url="{{ routes.product_recommendations_url }}?section_id=cart-recommendations&product_id={{ cart.items.first.product_id }}&limit=3&intent=related"
          ></cart-recommendations>
        {%- endif -%}
      {%- else -%}
        <div class="cart-drawer__empty">
          <p>{{ 'cart.general.empty' | t }}</p>
          <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
            {{- 'general.continue_shopping' | t -}}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__footer">
        {%- for discount in cart.cart_level_discount_applications -%}
          <p class="cart-drawer__discount">
            {{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})
          </p>
        {%- endfor -%}
        <p class="cart-drawer__subtotal">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money_with_currency }}</strong>
        </p>
        <p class="cart-drawer__taxes">{{ 'cart.general.taxes_and_shipping' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button class="button button--primary button--full" type="submit" name="checkout">
            {{- 'cart.general.checkout' | t -}}
          </button>
        </form>
        <a class="cart-drawer__view-cart" href="{{ routes.cart_url }}">{{ 'cart.general.view_cart' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Carrito lateral",
  "settings": [
    {
      "type": "checkbox",
      "id": "recommendations",
      "label": "Mostrar recomendaciones",
      "default": true
    }
  ]
}
{% endschema %}
