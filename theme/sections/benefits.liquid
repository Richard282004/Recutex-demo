{%- comment -%}
  Store benefits. Only publish facts the business can back (warranty terms, payment methods, etc.).
{%- endcomment -%}
{{ 'section-home.css' | asset_url | stylesheet_tag }}

<section class="section benefits" aria-labelledby="Heading-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__title benefits__heading" id="Heading-{{ section.id }}">
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}
    <ul class="benefits__list" role="list">
      {%- for block in section.blocks -%}
        <li class="benefit" data-reveal {{ block.shopify_attributes }}>
          <span class="benefit__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3 class="benefit__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="benefit__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <a class="link benefit__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Beneficios",
  "tag": "div",
  "max_blocks": 6,
  "settings": [{ "type": "text", "id": "heading", "label": "Título", "default": "Por qué comprar en Recutex" }],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "factory", "label": "Fábrica" },
            { "value": "shield", "label": "Garantía" },
            { "value": "card", "label": "Pago" },
            { "value": "truck", "label": "Despacho" },
            { "value": "chat", "label": "Atención" },
            { "value": "recycle", "label": "Reciclaje" },
            { "value": "store", "label": "Tienda" }
          ],
          "default": "factory"
        },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "richtext", "id": "text", "label": "Texto" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Beneficios", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }]
}
{% endschema %}
