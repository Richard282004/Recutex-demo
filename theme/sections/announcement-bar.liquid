{%- if section.blocks.size > 0 -%}
  <div
    class="announcement-bar"
    role="region"
    aria-label="{{ section.settings.aria_label | escape }}"
    {{ section.shopify_attributes }}
  >
    <div class="page-width announcement-bar__inner">
      {%- for block in section.blocks -%}
        <p class="announcement-bar__message" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "section-announcement-bar",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 3,
  "settings": [{ "type": "text", "id": "aria_label", "label": "Etiqueta accesible", "default": "Anuncios" }],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anuncio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Barra de anuncios" }]
}
{% endschema %}
