{%- comment -%}
  Category tiles. Each block points to a real collection; title, image and product count come from
  Shopify unless overridden in the Theme Editor.
{%- endcomment -%}
{{ 'section-home.css' | asset_url | stylesheet_tag }}

<section class="section collection-tiles" aria-labelledby="Heading-{{ section.id }}">
  <div class="page-width">
    <div class="section__header">
      <div>
        <h2 class="section__title" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="section__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
      <a class="link" href="{{ routes.collections_url }}">{{ 'collections.general.view_all_categories' | t }}</a>
    </div>

    <ul class="collection-tiles__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign tile_image = block.settings.image | default: c.featured_image
          assign tile_title = block.settings.title | default: c.title
          assign contain = false
          if block.settings.image == blank
            assign contain = true
          endif
        -%}
        <li
          class="collection-tile{% if forloop.first and section.settings.feature_first %} collection-tile--featured{% endif %}"
          data-reveal
          {{ block.shopify_attributes }}
        >
          <a class="collection-tile__link" href="{{ c.url | default: routes.collections_url }}">
            <span class="collection-tile__media{% if contain %} collection-tile__media--contain{% endif %}">
              {%- if tile_image -%}
                {{
                  tile_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900, 1200',
                    sizes: '(min-width: 990px) 25vw, 60vw',
                    alt: ''
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </span>
            <span class="collection-tile__text">
              <span class="collection-tile__title">{{ tile_title | escape }}</span>
              {%- if c != blank and c.products_count > 0 -%}
                <span class="collection-tile__count">
                  {{- 'collections.general.products_count' | t: count: c.products_count -}}
                </span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Categorías",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Explora por categoría" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" },
    { "type": "checkbox", "id": "feature_first", "label": "Destacar la primera categoría (desktop)", "default": true }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título (opcional)" },
        { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
