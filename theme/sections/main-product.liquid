{%- comment -%}
  Product page. Gallery (swipe + thumbnails + zoom), variant picker, quantity, add to cart, buy now,
  availability and editable accordions. Works without JS (the form posts a <select name="id"> fallback).
  Variant changes re-render price/availability/buttons through the Section Rendering API (product.js).
{%- endcomment -%}
{{ 'section-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" type="module"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
-%}

<section class="section product" data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <div class="page-width">
    {% render 'breadcrumbs' %}

    <div class="product__grid">
      {%- comment -%} Gallery {%- endcomment -%}
      <product-gallery class="product-gallery" data-reveal>
        <div class="product-gallery__viewport">
          <ul class="product-gallery__track" role="list" aria-label="{{ 'products.product.gallery' | t }}">
            {%- for media in product.media -%}
              <li
                class="product-gallery__slide"
                id="Slide-{{ section.id }}-{{ media.id }}"
                data-media-id="{{ media.id }}"
                {% if media.id == featured_media.id %}
                  aria-current="true"
                {% endif %}
              >
                {%- if media.media_type == 'image' -%}
                  <button
                    class="product-gallery__zoom"
                    type="button"
                    data-zoom-src="{{ media | image_url: width: 2400 }}"
                    aria-label="{{ 'products.product.zoom' | t }}"
                  >
                    {%- liquid
                      assign loading = 'lazy'
                      assign priority = 'auto'
                      if media.id == featured_media.id
                        assign loading = 'eager'
                        assign priority = 'high'
                      endif
                    -%}
                    {{
                      media
                      | image_url: width: 1800
                      | image_tag:
                        loading: loading,
                        fetchpriority: priority,
                        widths: '400, 600, 800, 1000, 1200, 1500, 1800',
                        sizes: '(min-width: 990px) 58vw, 100vw',
                        alt: media.alt
                      | default: product.title
                    }}
                  </button>
                {%- else -%}
                  {{ media | media_tag: image_size: '1200x' }}
                {%- endif -%}
              </li>
            {%- else -%}
              <li class="product-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</li>
            {%- endfor -%}
          </ul>
          {%- if product.media.size > 1 -%}
            <p class="product-gallery__counter" aria-hidden="true">
              <span data-gallery-index>1</span> / {{ product.media.size }}
            </p>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <ul class="product-gallery__thumbs" role="list">
            {%- for media in product.media -%}
              <li>
                <button
                  class="product-gallery__thumb"
                  type="button"
                  data-target="Slide-{{ section.id }}-{{ media.id }}"
                  aria-label="{{ 'products.product.thumbnail' | t: number: forloop.index }}"
                  {% if media.id == featured_media.id %}
                    aria-current="true"
                  {% endif %}
                >
                  {{
                    media.preview_image
                    | image_url: width: 200
                    | image_tag: loading: 'lazy', widths: '100, 200', sizes: '72px', alt: ''
                  }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <dialog class="zoom-dialog" aria-label="{{ 'products.product.zoom' | t }}">
          <button class="icon-button zoom-dialog__close" type="button" data-zoom-close>
            {% render 'icon', name: 'close' %}
            <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
          </button>
          <div class="zoom-dialog__stage" data-zoom-stage></div>
        </dialog>
      </product-gallery>

      {%- comment -%} Info column (blocks, reorderable in the Theme Editor) {%- endcomment -%}
      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'title' -%}
              <div class="product__title-wrap" {{ block.shopify_attributes }}>
                {%- if block.settings.show_vendor and product.vendor != blank -%}
                  <p class="product__vendor">{{ product.vendor | escape }}</p>
                {%- endif -%}
                <h1 class="product__title">{{ product.title | escape }}</h1>
              </div>

            {%- when 'price' -%}
              <div class="product__price" id="Price-{{ section.id }}" {{ block.shopify_attributes }}>
                {% render 'price', product: product, use_variant: true %}
                {%- if cart.taxes_included -%}
                  <p class="product__tax-note">{{ 'products.product.taxes_included' | t }}</p>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <variant-picker
                  class="variant-picker"
                  data-section-id="{{ section.id }}"
                  data-url="{{ product.url }}"
                  {{ block.shopify_attributes }}
                >
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-picker__option">
                      <legend class="field__label">
                        {{ option.name | escape }}:
                        <span class="variant-picker__selected" data-option-selected="{{ forloop.index0 }}">
                          {{- option.selected_value | escape -}}
                        </span>
                      </legend>
                      <div class="variant-picker__values">
                        {%- for value in option.values -%}
                          <input
                            class="visually-hidden"
                            type="radio"
                            id="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                            name="options[{{ option.name | escape }}]"
                            value="{{ value | escape }}"
                            data-option-index="{{ forloop.parentloop.index0 }}"
                            {% if option.selected_value == value %}
                              checked
                            {% endif %}
                          >
                          <label
                            class="pill"
                            for="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                          >
                            {{- value | escape -}}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json" data-variants>
                    {{ product.variants | json }}
                  </script>
                </variant-picker>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="product__buy" id="Buy-{{ section.id }}" {{ block.shopify_attributes }}>
                {%- form 'product',
                  product,
                  id: form_id,
                  class: 'product-form',
                  novalidate: 'novalidate',
                  data-product-form: ''
                -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <noscript>
                    {%- unless product.has_only_default_variant -%}
                      <label class="field__label" for="VariantSelect-{{ section.id }}">
                        {{- 'products.product.variant' | t -}}
                      </label>
                      <select class="field__input" id="VariantSelect-{{ section.id }}" name="id">
                        {%- for variant in product.variants -%}
                          <option
                            value="{{ variant.id }}"
                            {% if variant == current_variant %}
                              selected
                            {% endif -%}
                            {% unless variant.available %}
                              disabled
                            {% endunless %}
                          >
                            {{ variant.title | escape }} – {{ variant.price | money }}
                          </option>
                        {%- endfor -%}
                      </select>
                    {%- endunless -%}
                  </noscript>

                  <p class="product__availability{% unless current_variant.available %} is-out{% endunless %}">
                    <span class="product__availability-dot" aria-hidden="true"></span>
                    {%- if current_variant.available -%}
                      {{ 'products.product.in_stock' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </p>

                  <div class="product-form__row">
                    {%- if block.settings.show_quantity -%}
                      <quantity-input class="quantity">
                        <button
                          class="quantity__button"
                          type="button"
                          name="minus"
                          aria-label="{{ 'products.product.decrease' | t }}"
                        >
                          −
                        </button>
                        <input
                          class="quantity__input"
                          type="number"
                          name="quantity"
                          value="1"
                          min="1"
                          inputmode="numeric"
                          aria-label="{{ 'products.product.quantity' | t }}"
                        >
                        <button
                          class="quantity__button"
                          type="button"
                          name="plus"
                          aria-label="{{ 'products.product.increase' | t }}"
                        >
                          +
                        </button>
                      </quantity-input>
                    {%- endif -%}

                    <button
                      class="button button--primary product-form__submit"
                      type="submit"
                      name="add"
                      {% unless current_variant.available %}
                        disabled
                      {% endunless %}
                    >
                      <span class="button__label">
                        {%- if current_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                      <span class="button__state button__state--loading">
                        <span class="spinner"></span>
                        {{- 'products.product.adding' | t -}}
                      </span>
                      <span class="button__state button__state--success">
                        {% render 'icon', name: 'check' %}
                        {{- 'products.product.added' | t -}}
                      </span>
                    </button>
                  </div>

                  <p class="form-message form-message--error" role="alert" data-form-error hidden></p>

                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="product-form__dynamic">{{ form | payment_button }}</div>
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'collapsible' -%}
              {%- liquid
                assign content = block.settings.content
                if block.settings.page != blank
                  assign content = block.settings.page.content
                endif
                if block.settings.use_description
                  assign content = product.description
                endif
              -%}
              {%- if content != blank -%}
                <details
                  class="accordion"
                  {{ block.shopify_attributes -}}
                  {% if block.settings.open %}
                    open
                  {% endif %}
                >
                  <summary>{{ block.settings.heading | escape }}</summary>
                  <div class="accordion__content rte">{{ content }}</div>
                </details>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'contact' -%}
              {%- if settings.whatsapp_number != blank -%}
                {%- liquid
                  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' '
                  assign wa_text = 'products.product.whatsapp_message' | t: title: product.title, url: canonical_url
                -%}
                <a
                  class="product__contact"
                  href="https://wa.me/{{ wa_number }}?text={{ wa_text | url_encode }}"
                  target="_blank"
                  rel="noopener"
                  {{ block.shopify_attributes }}
                >
                  {% render 'icon', name: 'chat' %}
                  <span>{{ block.settings.label | escape }}</span>
                </a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "tag": "div",
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Título",
      "limit": 1,
      "settings": [{ "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": false }]
    },
    { "type": "price", "name": "Precio", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "Selector de variantes", "limit": 1, "settings": [] },
    {
      "type": "buy_buttons",
      "name": "Botones de compra",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Mostrar cantidad", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar \"Comprar ahora\"", "default": true }
      ]
    },
    { "type": "description", "name": "Descripción", "limit": 1, "settings": [] },
    {
      "type": "collapsible",
      "name": "Acordeón",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Información" },
        { "type": "checkbox", "id": "use_description", "label": "Usar la descripción del producto", "default": false },
        { "type": "richtext", "id": "content", "label": "Contenido" },
        { "type": "page", "id": "page", "label": "O contenido de una página" },
        { "type": "checkbox", "id": "open", "label": "Abierto por defecto", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [{ "type": "richtext", "id": "text", "label": "Texto" }]
    },
    {
      "type": "contact",
      "name": "Consulta por WhatsApp",
      "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "Texto", "default": "¿Dudas? Escríbenos por WhatsApp" }]
    }
  ]
}
{% endschema %}
