{{ 'section-pages.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Base cart page (Phase 2). Works without JS via standard /cart form posts.
  Cart drawer (Ajax Cart API) arrives in Phase 10.
{%- endcomment -%}
<section class="section cart">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart__form" id="CartForm">
        <ul class="cart__items" role="list">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{
                    item.image
                    | image_url: width: 240
                    | image_tag: loading: 'lazy', widths: '120, 240', sizes: '120px', alt: item.image.alt
                  }}
                {%- endif -%}
              </a>
              <div class="cart-item__details">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- unless property.last == blank or property.first contains '_' -%}
                    <p class="cart-item__property">{{ property.first }}: {{ property.last }}</p>
                  {%- endunless -%}
                {%- endfor -%}
                <p class="cart-item__price">
                  {%- if item.original_line_price > item.final_line_price -%}
                    <s>{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  {{ item.final_line_price | money }}
                </p>
                {%- for discount in item.line_level_discount_allocations -%}
                  <p class="cart-item__discount">{{ discount.discount_application.title | escape }}</p>
                {%- endfor -%}
              </div>
              <div class="cart-item__quantity">
                <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                  {{- 'products.product.quantity' | t -}}
                </label>
                <input
                  class="field__input"
                  id="Quantity-{{ item.index | plus: 1 }}"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  inputmode="numeric"
                >
                <a class="link cart-item__remove" href="{{ item.url_to_remove }}">
                  {{- 'cart.general.remove' | t: title: item.product.title -}}
                </a>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if settings.cart_show_note -%}
          <div class="field">
            <label class="field__label" for="CartNote">{{ 'cart.general.note' | t }}</label>
            <textarea class="field__input" id="CartNote" name="note">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}

        <div class="cart__footer">
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart__discount">{{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</p>
          {%- endfor -%}
          <p class="cart__subtotal">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money_with_currency }}</strong>
          </p>
          <p class="cart__taxes">{{ 'cart.general.taxes_and_shipping' | t }}</p>
          <div class="cart__buttons">
            <button class="button" type="submit" name="update">{{ 'cart.general.update' | t }}</button>
            <button class="button button--primary" type="submit" name="checkout">
              {{- 'cart.general.checkout' | t -}}
            </button>
          </div>
          {%- if additional_checkout_buttons -%}
            <div class="cart__dynamic-checkout">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </form>
    {%- else -%}
      <p class="empty-state">{{ 'cart.general.empty' | t }}</p>
      <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
        {{- 'general.continue_shopping' | t -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrito",
  "settings": []
}
{% endschema %}
