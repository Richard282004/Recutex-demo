<section class="section">
  <div class="page-width page-width--narrow text-center">
    <h1 class="section__title">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'password-form' -%}
      {{ form.errors | default_errors }}
      <label class="field__label" for="Password">{{ 'general.password.password' | t }}</label>
      <input class="field__input" type="password" name="password" id="Password" autocomplete="current-password">
      <button class="button button--primary" type="submit">{{ 'general.password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contraseña",
  "settings": []
}
{% endschema %}
