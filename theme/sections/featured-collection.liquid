{%- comment -%}
  Product rail / grid from a real collection. Used for Ofertas, Destacados, Colchones, Camas, Living,
  Recomendados. Prices, discounts and availability come from Shopify.
{%- endcomment -%}
{{ 'section-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section
  class="section featured-collection{% if section.settings.tinted %} section--tinted{% endif %}"
  aria-labelledby="Heading-{{ section.id }}"
>
  <product-rail class="page-width">
    <div class="section__header">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="section__title" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="section__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
      <div class="featured-collection__actions">
        {%- if collection != blank -%}
          <a class="link" href="{{ collection.url }}">
            {{- section.settings.link_label | default: collection.title | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.layout == 'rail' -%}
          <div class="rail-controls">
            <button class="icon-button" type="button" data-rail-prev aria-label="{{ 'general.slider.previous' | t }}">
              {% render 'icon', name: 'chevron-left' %}
            </button>
            <button class="icon-button" type="button" data-rail-next aria-label="{{ 'general.slider.next' | t }}">
              {% render 'icon', name: 'chevron-right' %}
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <ul class="{% if section.settings.layout == 'rail' %}rail{% else %}product-grid{% endif %}" role="list">
        {%- for product in collection.products limit: limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="empty-state">{{ 'collections.general.choose_collection' | t }}</p>
    {%- endif -%}
  </product-rail>
</section>

{% schema %}
{
  "name": "Colección de productos",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Productos destacados" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver todo" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos a mostrar",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Formato",
      "options": [
        { "value": "rail", "label": "Carrusel" },
        { "value": "grid", "label": "Grilla" }
      ],
      "default": "rail"
    },
    { "type": "checkbox", "id": "tinted", "label": "Fondo de color", "default": false }
  ],
  "presets": [{ "name": "Colección de productos" }]
}
{% endschema %}
