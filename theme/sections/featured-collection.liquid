{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section class="section featured-collection" aria-labelledby="Heading-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header">
        <h2 class="section__title" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if collection != blank -%}
          <a class="link" href="{{ collection.url }}">{{ 'products.product.view_details' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection != blank and collection.products_count > 0 -%}
      <ul class="product-grid" role="list">
        {%- for product in collection.products limit: limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Productos destacados" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos a mostrar",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
