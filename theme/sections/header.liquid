{%- comment -%}
  Header: sticky, mega menu (desktop), drawer navigation (mobile), search and cart triggers.
  Navigation comes from the Shopify menu selected in the Theme Editor:
  level 1 = top items, level 2 = mega menu columns, level 3 = column links.
  Promo blocks attach an image/collection to a top-level item by its title.
{%- endcomment -%}
{{ 'component-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign menu = section.settings.menu
  assign logo_tag = 'div'
-%}

<sticky-header class="site-header" data-hide-on-scroll="{{ section.settings.hide_on_scroll }}">
  {% render 'brand-bands', class: 'site-header__bands' %}
  <div class="page-width site-header__inner">
    <button
      class="icon-button site-header__menu-toggle"
      type="button"
      aria-controls="MenuDrawer"
      aria-expanded="false"
      data-drawer-open="MenuDrawer"
    >
      {% render 'icon', name: 'menu' %}
      <span class="visually-hidden">{{ 'general.accessibility.menu' | t }}</span>
    </button>

    <{{ logo_tag }} class="site-header__logo">
      <a href="{{ routes.root_url }}" class="site-header__logo-link">
        {%- if settings.logo != blank -%}
          {%- assign logo_sizes = settings.logo_width | append: 'px' -%}
          {{
            settings.logo
            | image_url: width: 520
            | image_tag:
              loading: 'eager',
              widths: '130, 260, 390, 520',
              sizes: logo_sizes,
              alt: shop.name,
              class: 'site-header__logo-image'
          }}
        {%- else -%}
          <span class="site-header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </{{ logo_tag }}>

    <mega-menu class="site-nav">
      <nav aria-label="{{ 'general.accessibility.main_navigation' | t }}">
        <ul class="site-nav__list" role="list">
          {%- for link in menu.links -%}
            <li class="site-nav__item">
              {%- if link.links.size > 0 -%}
                <button
                  class="site-nav__link site-nav__trigger"
                  type="button"
                  aria-expanded="false"
                  aria-controls="MegaMenu-{{ forloop.index }}"
                >
                  {{- link.title | escape -}}
                  {% render 'icon', name: 'chevron-down' %}
                </button>
                <div class="mega-menu" id="MegaMenu-{{ forloop.index }}" hidden>
                  <div class="page-width mega-menu__inner">
                    <div class="mega-menu__columns">
                      {%- for child in link.links -%}
                        <div class="mega-menu__column">
                          <a class="mega-menu__heading" href="{{ child.url }}">{{ child.title | escape }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul class="mega-menu__links" role="list">
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a
                                    href="{{ grandchild.url }}"
                                    {% if grandchild.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{- grandchild.title | escape -}}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                      <div class="mega-menu__column">
                        <a class="link" href="{{ link.url }}">
                          {{- 'general.header.view_all' | t: title: link.title -}}
                        </a>
                      </div>
                    </div>

                    {%- for block in section.blocks -%}
                      {%- assign block_item = block.settings.menu_item | strip | downcase -%}
                      {%- assign link_title = link.title | strip | downcase -%}
                      {%- if block_item == link_title -%}
                        {%- liquid
                          assign promo_image = block.settings.image
                          if promo_image == blank and block.settings.collection != blank
                            assign promo_image = block.settings.collection.featured_image
                          endif
                          assign promo_url = block.settings.link | default: block.settings.collection.url
                        -%}
                        <a class="mega-menu__promo" href="{{ promo_url }}" {{ block.shopify_attributes }}>
                          {%- if promo_image -%}
                            {{
                              promo_image
                              | image_url: width: 800
                              | image_tag:
                                loading: 'lazy',
                                widths: '400, 600, 800',
                                sizes: '360px',
                                alt: '',
                                class: 'mega-menu__promo-image'
                            }}
                          {%- endif -%}
                          <span class="mega-menu__promo-text">
                            {%- if block.settings.heading != blank -%}
                              <strong>{{ block.settings.heading | escape }}</strong>
                            {%- endif -%}
                            {%- if block.settings.text != blank -%}
                              <span>{{ block.settings.text | escape }}</span>
                            {%- endif -%}
                          </span>
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- else -%}
                <a
                  class="site-nav__link"
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </mega-menu>

    <div class="site-header__actions">
      <button
        class="icon-button"
        type="button"
        aria-controls="SearchDrawer"
        aria-expanded="false"
        data-drawer-open="SearchDrawer"
      >
        {% render 'icon', name: 'search' %}
        <span class="visually-hidden">{{ 'general.search.search' | t }}</span>
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-button site-header__account" href="{{ routes.account_url }}">
          {% render 'icon', name: 'account' %}
          <span class="visually-hidden">{{ 'general.header.account' | t }}</span>
        </a>
      {%- endif -%}
      <a
        class="icon-button"
        href="{{ routes.cart_url }}"
        id="CartIcon"
        {% if settings.cart_type == 'drawer' %}
          data-drawer-open="CartDrawer" aria-controls="CartDrawer" aria-expanded="false" role="button"
        {% endif %}
      >
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">{{ 'general.header.cart' | t }}</span>
        {% render 'cart-count' %}
      </a>
    </div>
  </div>
</sticky-header>

{%- comment -%} Mobile navigation drawer {%- endcomment -%}
<drawer-panel class="drawer drawer--left" id="MenuDrawer" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div
    class="drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'general.accessibility.menu' | t }}"
    tabindex="-1"
  >
    <div class="drawer__header">
      <span class="drawer__title">{{ 'general.accessibility.menu' | t }}</span>
      <button class="icon-button" type="button" data-drawer-close>
        {% render 'icon', name: 'close' %}
        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
      </button>
    </div>
    <nav class="drawer__body menu-drawer" aria-label="{{ 'general.accessibility.main_navigation' | t }}">
      <ul class="menu-drawer__list" role="list">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details class="accordion menu-drawer__group">
                <summary>{{ link.title | escape }}</summary>
                <div class="accordion__content">
                  <ul role="list">
                    {%- for child in link.links -%}
                      <li>
                        <a href="{{ child.url }}">{{ child.title | escape }}</a>
                        {%- if child.links.size > 0 -%}
                          <ul role="list" class="menu-drawer__sublist">
                            {%- for grandchild in child.links -%}
                              <li>
                                <a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                    <li>
                      <a class="link" href="{{ link.url }}">{{ 'general.header.view_all' | t: title: link.title }}</a>
                    </li>
                  </ul>
                </div>
              </details>
            {%- else -%}
              <a class="menu-drawer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if shop.customer_accounts_enabled -%}
        <a class="button button--full menu-drawer__account" href="{{ routes.account_url }}">
          {% render 'icon', name: 'account' %}
          {{ 'general.header.account' | t }}
        </a>
      {%- endif -%}
    </nav>
  </div>
</drawer-panel>

{% render 'predictive-search-drawer', popular: section.settings.popular_searches %}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menú principal", "default": "main-menu" },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "Ocultar al bajar, mostrar al subir",
      "default": true
    },
    {
      "type": "text",
      "id": "popular_searches",
      "label": "Búsquedas populares",
      "info": "Separadas por coma. Se muestran al abrir el buscador.",
      "default": "Colchón, Camarote, Sofá cama, Espuma"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promoción de mega menú",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Ítem del menú",
          "info": "Título exacto del ítem de primer nivel donde aparece (ej: Dormitorio)."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección",
          "info": "Usa su imagen y enlace si no eliges otros."
        },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ]
}
{% endschema %}
