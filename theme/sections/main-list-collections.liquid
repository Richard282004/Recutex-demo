{{ 'section-pages.css' | asset_url | stylesheet_tag }}

<section class="section">
  <div class="page-width">
    <h1 class="page-title">{{ section.settings.title | escape }}</h1>
    <ul class="collection-list" role="list">
      {%- for collection in collections -%}
        {%- if collection.products_count > 0 -%}
          <li class="collection-list__item">
            <a href="{{ collection.url }}" class="collection-list__link">
              {%- assign image = collection.featured_image -%}
              {%- if image -%}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 33vw, 50vw',
                    alt: collection.title
                }}
              {%- endif -%}
              <span class="collection-list__title">{{ collection.title | escape }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Lista de colecciones",
  "settings": [{ "type": "text", "id": "title", "label": "Título", "default": "Categorías" }]
}
{% endschema %}
