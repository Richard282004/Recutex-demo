{{ 'section-pages.css' | asset_url | stylesheet_tag }}
{{ 'section-home.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Base search page (Phase 2). Predictive search overlay arrives in Phase 9.
{%- endcomment -%}
{%- paginate search.results by 24 -%}
  <section class="section search">
    <div class="page-width">
      <h1 class="page-title">{{ 'search.title' | t }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <label class="visually-hidden" for="SearchInput">{{ 'general.search.search' | t }}</label>
        <input
          class="field__input"
          id="SearchInput"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button class="button button--primary" type="submit">{{ 'general.search.search' | t }}</button>
      </form>

      {%- if search.performed -%}
        {%- if search.results_count > 0 -%}
          <p class="search__count">
            {{- 'search.results_for' | t: count: search.results_count, terms: search.terms -}}
          </p>
          <ul class="product-grid" role="list">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a class="search-result" href="{{ item.url }}">{{ item.title | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p class="empty-state">{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Búsqueda",
  "settings": []
}
{% endschema %}
