[
  {
    "name": "theme_info",
    "theme_name": "Recutex 2.0",
    "theme_version": "0.1.0",
    "theme_author": "Recutex",
    "theme_documentation_url": "https://recutex.myshopify.com",
    "theme_support_url": "https://recutex.myshopify.com"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Ancho del logo",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Se escalará a 32 × 32 px"
      }
    ]
  },
  {
    "name": "Marca",
    "settings": [
      {
        "type": "checkbox",
        "id": "brand_bands",
        "label": "Mostrar bandas de color de la marca",
        "default": true,
        "info": "Las franjas de color del logo Recutex, usadas como acento en el header y el hero."
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primario",
        "default": "#1B2340"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secundario (paneles suaves)",
        "default": "#E6EAF1"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Fondo",
        "default": "#F6F7F9"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Superficie (tarjetas, paneles)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texto",
        "default": "#151A2B"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Texto secundario",
        "default": "#5B6275"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Ofertas",
        "default": "#D42A20"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "checkbox",
        "id": "type_heading_brand",
        "label": "Usar tipografía de marca en títulos (Bricolage Grotesque)",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Títulos (si no se usa la de marca)",
        "default": "inter_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Texto",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Al agregar al carrito",
        "options": [
          {
            "value": "drawer",
            "label": "Abrir carrito lateral"
          },
          {
            "value": "page",
            "label": "Ir a la página del carrito"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Permitir nota del pedido",
        "default": false
      }
    ]
  },
  {
    "name": "Contacto",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp (solo números, con código de país)",
        "info": "Ej: 56912345678. Vacío = oculta el botón."
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "Mensaje inicial de WhatsApp",
        "default": "Hola, tengo una consulta sobre un producto."
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Teléfono"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Email"
      }
    ]
  },
  {
    "name": "Animaciones",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_reveal",
        "label": "Revelar contenido al hacer scroll",
        "default": true
      }
    ]
  }
]
