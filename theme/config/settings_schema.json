[
  {
    "name": "theme_info",
    "theme_name": "Recutex 2.0",
    "theme_version": "0.1.0",
    "theme_author": "Recutex",
    "theme_documentation_url": "https://recutex.myshopify.com",
    "theme_support_url": "https://recutex.myshopify.com"
  },
  {
    "name": "Logo",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Ancho del logo",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "default": 140
      },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Se escalará a 32 × 32 px" }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      { "type": "color", "id": "color_primary", "label": "Primario", "default": "#1F2A44" },
      { "type": "color", "id": "color_secondary", "label": "Secundario", "default": "#C8B89E" },
      { "type": "color", "id": "color_background", "label": "Fondo", "default": "#FAF8F5" },
      { "type": "color", "id": "color_surface", "label": "Superficie (tarjetas, paneles)", "default": "#FFFFFF" },
      { "type": "color", "id": "color_text", "label": "Texto", "default": "#1A1D24" },
      { "type": "color", "id": "color_muted", "label": "Texto secundario", "default": "#626773" },
      { "type": "color", "id": "color_sale", "label": "Ofertas", "default": "#B4321F" }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      { "type": "font_picker", "id": "type_heading_font", "label": "Títulos", "default": "inter_n6" },
      { "type": "font_picker", "id": "type_body_font", "label": "Texto", "default": "inter_n4" }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Permitir nota del pedido",
        "default": false
      }
    ]
  }
]
