{
  "name": "recutex-storefront",
  "version": "0.2.0",
  "private": true,
  "description": "RECUTEX 2.0 — storefront propio en Next.js (sin plataforma SaaS).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "catalog:snapshot": "node scripts/snapshot-catalog.mjs",
    "check:legacy-urls": "node scripts/check-legacy-urls.mjs",
    "falabella:snapshot": "node scripts/snapshot-falabella.mjs",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-seed.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "transbank-sdk": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
