# Copy to .env (read by Next.js, docker compose and the scripts) — never commit real values.
# Every value below is a placeholder.

# Public URL of the site (used for canonical URLs, sitemap and the Webpay return URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webpay Plus. "integration" uses Transbank's public test credentials (no real charges).
WEBPAY_ENV=integration
# Only for WEBPAY_ENV=production (provided by Transbank to the merchant):
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# robots.txt blocks indexing unless this is "true" (only in production, on the final domain).
ALLOW_INDEXING=false

# PostgreSQL (docker compose up -d db). Choose your own local password (letters and digits); it is set when the database
# volume is first created. Inside Docker the app uses the "db" host set in docker-compose.yml.
POSTGRES_PASSWORD=example-local-password
DATABASE_URL=postgres://recutex:example-local-password@localhost:5433/recutex
# Folder with the product photos served under /media (filled by npm run db:seed).
MEDIA_DIR=storage/media
