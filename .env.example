# Copy to .env and fill in. Never commit .env.

# Store the theme is developed against. For the sales demo this is YOUR development store
# (e.g. recutex-demo.myshopify.com), never the real Recutex store.
SHOPIFY_FLAG_STORE=

# Optional: Theme Access password (starts with shptka_).
# Generated from the "Theme Access" app in the Shopify admin.
# If empty, the CLI falls back to interactive login (device code in the terminal).
SHOPIFY_CLI_THEME_TOKEN=

# ID of the unpublished QA/staging theme used by `npm run push:staging`.
# Get it with `npm run theme:list`. Must NEVER be the live theme ID.
SHOPIFY_STAGING_THEME_ID=

# Port for the local theme dev preview (http://localhost:9292)
THEME_DEV_PORT=9292

# --- Demo store seeding (npm run demo:seed) ---
# Demo development store domain and an Admin API access token (shpat_...) from a custom app
# installed in that store. See docs/DEMO.md. The script refuses to run on recutex.myshopify.com.
SHOPIFY_DEMO_STORE=
SHOPIFY_ADMIN_TOKEN=
